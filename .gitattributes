# Workflow files carry embedded shell scripts that run on Linux runners. A CRLF
# checkout would put a carriage return at the end of every line and break bash
# with "command not found" errors, so pin these to LF regardless of
# core.autocrlf (which is `true` on the Windows dev machine).
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
